# Nexus Docker Environment Configuration Template
# Copy this file to .env and customize as needed

# Nexus Configuration
NEXUS_VERSION=3.82.0
NEXUS_DATA_PATH=./data/nexus-data
NEXUS_SECURITY_RANDOMPASSWORD=false

# Database Configuration
POSTGRES_VERSION=17
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus123
POSTGRES_DATA_PATH=./data/postgres-data

# Network Configuration
NEXUS_HTTP_PORT=8081
NEXUS_DOCKER_PORT=8082
NEXUS_DOCKER_PROXY_PORT=8083
POSTGRES_PORT=5432
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Traefik Configuration
TRAEFIK_DASHBOARD=true
TRAEFIK_LOG_LEVEL=INFO
ACME_EMAIL=your-email@example.com

# SSL/TLS Configuration
DOMAIN_NAME=nexus.example.com
REGISTRY_DOMAIN=registry.example.com

# Resource Limits
NEXUS_MEMORY=2g
NEXUS_HEAP_SIZE=1g
POSTGRES_MEMORY=512m

# Security Configuration
ADMIN_PASSWORD=admin123
ENABLE_HTTPS=false
REQUIRE_SSL=false

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_ACCESS_LOGS=true
LOG_RETENTION_DAYS=7

# Repository Configuration
AUTO_CREATE_REPOS=true
ENABLE_DOCKER_REGISTRY=true
ENABLE_NPM_PROXY=true
ENABLE_PYPI_PROXY=true
ENABLE_MAVEN_PROXY=true

# Development/Testing Options
SKIP_INITIAL_SETUP=false
ENABLE_DEBUG_LOGGING=false
TEST_MODE=false
